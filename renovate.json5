{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "rebaseWhen": "behind-base-branch",
  "packageRules": [
    {
      "description": "Ignore project internal dependencies",
      "packagePattern": "^com.rapidclipse:rap",
      "datasources": [
        "maven"
      ],
      "enabled": false
    },
    {
      "description": "Ignore m2e - Eclipse internal - can't be resolved as these deps do not exist",
      "packagePattern": "^org.eclipse.m2e:",
      "datasources": [
        "maven"
      ],
      "enabled": false
    }
  ]
}
